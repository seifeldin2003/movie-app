# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local-only poster artwork used to eyeball the UI before the API lands.
# The directory itself is tracked so the pubspec asset entry always resolves;
# the images are not, so no third-party artwork ends up in the repo. Cards
# fall back to a generated tile when the files are absent.
assets/images/sample/*
!assets/images/sample/.gitkeep

# ── Secrets and per-developer configuration ──────────────────────────────────
# Generated by `flutterfire configure`. They carry the project's API keys, app
# ids and (in google-services.json) a signing certificate fingerprint.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase.json
.firebaserc

# Hand-maintained config. Copy the .example file beside each and fill it in.
lib/core/constants/app_config.dart
lib/core/constants/trailer_constants.dart
lib/core/network/api_endpoints.dart

# Internal team notes — not for the public repo.
CONTRIBUTING.md

# Signing — never commit a keystore or its passwords.
*.jks
*.keystore
android/key.properties
